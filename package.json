{
  "name": "token-binder",
  "displayName": "TokenBinder",
  "description": "%extension.description%",
  "version": "1.9.0",
  "publisher": "sorevir",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenBinder",
          "title": "TokenBinder",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tokenBinder": [
        {
          "type": "webview",
          "id": "tokenBinder.view",
          "name": "%view.companion%"
        }
      ]
    },
    "commands": [
      {
        "command": "tokenBinder.open",
        "title": "%command.open%",
        "category": "TokenBinder"
      },
      {
        "command": "tokenBinder.openAlbum",
        "title": "%command.openAlbum%",
        "category": "TokenBinder"
      },
      {
        "command": "tokenBinder.setQuota",
        "title": "%command.setQuota%",
        "category": "TokenBinder"
      },
      {
        "command": "tokenBinder.openSettings",
        "title": "%command.openSettings%",
        "category": "TokenBinder"
      },
      {
        "command": "tokenBinder.refresh",
        "title": "%command.refresh%",
        "category": "TokenBinder"
      },
      {
        "command": "tokenBinder.checkForUpdates",
        "title": "%command.checkForUpdates%",
        "category": "TokenBinder"
      },
      {
        "command": "tokenBinder.exportProgress",
        "title": "%command.exportProgress%",
        "category": "TokenBinder"
      },
      {
        "command": "tokenBinder.importProgress",
        "title": "%command.importProgress%",
        "category": "TokenBinder"
      },
      {
        "command": "tokenBinder.resetProgress",
        "title": "%command.resetProgress%",
        "category": "TokenBinder"
      }
    ],
    "configuration": {
      "title": "TokenBinder",
      "properties": {
        "tokenBinder.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "es"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.es%"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "tokenBinder.updates.check": {
          "type": "boolean",
          "default": true,
          "description": "%config.updates.check%"
        },
        "tokenBinder.mishaps.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.mishaps.enabled%"
        },
        "tokenBinder.quota.unit": {
          "type": "string",
          "enum": [
            "tokens",
            "credits"
          ],
          "default": "tokens",
          "description": "%config.quota.unit%"
        },
        "tokenBinder.quota.monthlyLimit": {
          "type": "number",
          "default": 5000000,
          "minimum": 1,
          "description": "%config.quota.monthlyLimit%"
        },
        "tokenBinder.quota.resetDay": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 28,
          "description": "%config.quota.resetDay%"
        },
        "tokenBinder.alerts.thresholds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": [
            50,
            80,
            100
          ],
          "description": "%config.alerts.thresholds%"
        },
        "tokenBinder.packs.everyTokens": {
          "type": "number",
          "default": 750000,
          "minimum": 50000,
          "description": "%config.packs.everyTokens%"
        },
        "tokenBinder.growth.multiplier": {
          "type": "number",
          "default": 1,
          "minimum": 0.1,
          "maximum": 2,
          "description": "%config.growth.multiplier%"
        },
        "tokenBinder.storageRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.storageRoots%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node --import tsx --test test/*.test.ts",
    "package": "node esbuild.mjs --release && vsce package --no-dependencies",
    "balance": "node --import tsx scripts/balance.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SoreviR/token-binder.git"
  },
  "homepage": "https://github.com/SoreviR/token-binder#readme",
  "bugs": {
    "url": "https://github.com/SoreviR/token-binder/issues"
  }
}
